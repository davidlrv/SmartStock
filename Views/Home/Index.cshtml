@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}


    <style>
       
        .card-dashboard {
            border: none;
            border-radius: 12px;
            color: white;
            transition: transform 0.2s ease;
        }

        .card-dashboard:hover {
            transform: translateY(-5px);
        }

        .bg-ventas { background: linear-gradient(45deg, #0d6efd, #3d8bfd); }
        .bg-inventario { background: linear-gradient(45deg, #198754, #20c997); }
        .bg-caja { background: linear-gradient(45deg, #ffc107, #ffcd39); color: #000; }
        .bg-compras { background: linear-gradient(45deg, #6f42c1, #9b6cff); }
        .bg-proveedores { background: linear-gradient(45deg, #dc3545, #ff6b6b); }

        .icon {
            font-size: 2rem;
            opacity: 0.8;
        }
    </style>

<div class="container py-4">

    <h3 class="mb-4">📊 Dashboard General</h3>

    <div class="row g-4">

        <!-- Ventas -->
        <div class="col-md-4 col-lg-3">
            <div class="card card-dashboard bg-ventas p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Ventas</h6>
                        <h3 id="ventasTotal">$0.00</h3>
                    </div>
                    <i class="bi bi-cart-check icon"></i>
                </div>
            </div>
        </div>

        <!-- Inventario -->
        <div class="col-md-4 col-lg-3">
            <div class="card card-dashboard bg-inventario p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Inventario</h6>
                        <h3 id="inventarioTotal">0</h3>
                    </div>
                    <i class="bi bi-box-seam icon"></i>
                </div>
            </div>
        </div>

        <!-- Caja -->
        <div class="col-md-4 col-lg-3">
            <div class="card card-dashboard bg-caja p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Caja</h6>
                        <h3 id="cajaTotal">$0.00</h3>
                    </div>
                    <i class="bi bi-cash-stack icon"></i>
                </div>
            </div>
        </div>

        <!-- Compras -->
        <div class="col-md-4 col-lg-3">
            <div class="card card-dashboard bg-compras p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Compras</h6>
                        <h3 id="comprasTotal">$0.00</h3>
                    </div>
                    <i class="bi bi-bag-check icon"></i>
                </div>
            </div>
        </div>

        <!-- Proveedores -->
        <div class="col-md-4 col-lg-3">
            <div class="card card-dashboard bg-proveedores p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Proveedores</h6>
                        <h3 id="proveedoresTotal">0</h3>
                    </div>
                    <i class="bi bi-truck icon"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla reciente -->
    <div class="card mt-5">
        <div class="card-header">
            Últimas Ventas
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody id="tablaVentas">
                    <tr>
                        <td>1</td>
                        <td>Juan Pérez</td>
                        <td>$120.00</td>
                        <td>2026-03-18</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>