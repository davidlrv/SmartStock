@{
    ViewData["Title"] = "Inventario - Ajustes";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<div class="container py-4">

    <h4 class="mb-4">⚙️ Ajustes - Inventario  </h4>

    <div class="row g-4">

       

        <!-- Unidad de Medida -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">📏 Unidades de medida</h5>
                    <p class="card-text">
                        Agregar, modificar y eliminar unidades de medida para productos e inventario.
                    </p>
                    <a asp-controller="Inventario" asp-action="ListaUnidadMedida" class="btn btn-outline-primary btn-sm">
                        Gestionar
                    </a>
                </div>
            </div>
        </div>

        <!-- Impuestos -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">💲 Impuestos</h5>
                    <p class="card-text">Define IVA, descuentos y reglas de facturación.</p>
                    <a asp-controller="Configuraciones" asp-action="ListaImpuestos" class="btn btn-outline-primary btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Fabricantes -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🏭 Fabricantes</h5>
                    <p class="card-text">
                        Agregar, modificar y eliminar fabricantes de productos y marcas.
                    </p>
                    <a asp-controller="Configuraciones" asp-action="ListaFabricante" class="btn btn-outline-primary btn-sm">
                        Gestionar
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
