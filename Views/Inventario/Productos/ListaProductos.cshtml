@model List<SmartStock.Models.Producto>

@{
    ViewData["Title"] = "Lista de Productos";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Productos</h3>

@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-0 d-flex">
        <a class="btn btn-success"
           asp-area=""
           asp-controller="Inventario"
           asp-action="Producto">
            Agregar Producto
        </a>
    </p>
}

<script>
    $(document).ready(function () {
        let table = new DataTable('#myTable', {
            responsive: true,
            language: {
                url: '/js/es-ES.json',
                emptyTable: "No hay productos disponibles."
            }
        });
    });
</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Código Barras</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Fabricante</th>
            <th>Proveedor</th>
            <th>Unidad</th>
            <th>Precio</th>
            <th>Impuesto</th>
            <th>Activo</th>
            <th>Opciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.ID_Producto</td>
                <td>@producto.Cod_Barras</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>@producto.Nombre_Fabricante</td>
                <td>@producto.Nombre_Proveedor</td>
                <td>@producto.Nombre_UnidadMedida</td>

                <td>@producto.Precio.ToString("N2")</td>

                <td>
                    @($"{producto.Porcentaje:N2}%")
                </td>

                <td>@(producto.Estado ? "Sí" : "No")</td>

                <td>
                    <div class="row">
                        <div class="col-6 text-center">
                            <a class="btn btn-detalles"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Producto"
                               asp-controller="Inventario"
                               asp-action="Producto"
                               asp-route-ID_Producto="@producto.ID_Producto">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>