@model List<SmartStock.Models.CategoriaProductos>

@{
    ViewData["Title"] = "Lista de Categorías";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Categorías de Productos</h3>

@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-0 d-flex">
        <a class="btn btn-success" asp-area="" asp-controller="Inventario" asp-action="Categorias">Agregar Categoría</a>
    </p>
}

<script>
    $(document).ready(function () {

    let table = new DataTable('#myTable', {
    responsive: true,
    language: {
    url: '/js/es-ES.json',
    emptyTable: "No hay categorías disponibles."
    }
    });

    });
</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">
    <thead>
        <tr>
            <th>Id Categoría</th>
            <th>Categoría</th>
            <th>Activo</th>
            <th>Opciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var Categoria in Model)
        {
            <tr>
                <td>@Categoria.ID_Categoria</td>
                <td>@Categoria.Categoria</td>
                <td>@(Categoria.Estado ? "Sí" : "No")</td>

                <td>
                    <div class="row">

                        <div class="col-6 text-center">

                            <a class="btn btn-detalles"
                                   data-bs-toggle='tooltip'
                                   data-bs-placement='top'
                                   title='Editar Categoría'
                                   asp-controller="Inventario"
                                   asp-action="Categorias"
                                   asp-route-ID_Categoria="@Categoria.ID_Categoria">

                                <i class="bi bi-pencil-square"></i>

                            </a>

                        </div>

                    </div>
                </td>
            </tr>
        }

    </tbody>
</table>