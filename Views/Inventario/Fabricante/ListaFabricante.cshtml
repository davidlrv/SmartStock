
@model List<SmartStock.Models.Fabricante>

@{
    ViewData["Title"] = "Lista de Fabricantes";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Fabricantes</h3>

@* Solamente Super Administrador puede agregar nuevos fabricantes *@
@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-0 d-flex">
        <a class="btn btn-success" asp-area="" asp-controller="Configuraciones" asp-action="Fabricante">
            Agregar Fabricante
        </a>
    </p>
}

<script>

    $(document).ready(function () {

        let table = new DataTable('#myTable', {

            responsive: true,

            language: {
                url: '/js/es-ES.json',
                emptyTable: "No hay fabricantes disponibles."
            }

        });

    });

</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">

    <thead>

        <tr>

            <th>ID Fabricante</th>
            <th>Nombre Fabricante</th>
            <th>Activo</th>
            <th>Opciones</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var fabricante in Model)
        {
            <tr>

                <td>@fabricante.ID_Fabricante</td>

                <td>@fabricante.Nombre_Fabricante</td>

                <td>@(fabricante.Estado ? "Sí" : "No")</td>

                <td>

                    <div class="row">

                        <div class="col-6 text-center">

                            <a class="btn btn-detalles"
                               data-bs-toggle='tooltip'
                               data-bs-placement='top'
                               title='Fabricante'
                               asp-controller="Configuraciones"
                               asp-action="Fabricante"
                               asp-route-ID_Fabricante="@fabricante.ID_Fabricante">

                                <i class="bi bi-pencil-square"></i>

                            </a>

                        </div>

                    </div>

                </td>

            </tr>
        }

    </tbody>

</table>
