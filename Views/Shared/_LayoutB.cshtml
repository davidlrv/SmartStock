@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStock</title>
     
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet" 
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.16.1/dist/sweetalert2.min.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
   

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.css" />
     <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.8/css/responsive.dataTables.min.css" />
  


    <meta name="author" content="SmartStock">
    <meta name="description" content="Sistema de inventario y punto de venta eficiente y fácil de usar. Controla tu stock, ventas y clientes desde una plataforma centralizada.">
    <meta name="keywords" content="sistema de inventario, punto de venta, POS, gestión de stock, facturación, ventas, control de productos, Nicaragua">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#19875405"> <!-- Color de la interfaz en navegadores móviles -->
    <meta property="og:title" content="Sistema de Inventario y Punto de Venta">
    <meta property="og:description" content="Optimiza tu negocio con un sistema de inventario y punto de venta ágil y seguro.">
    <meta property="og:image" content="@Configuration["Config:UrlLogo"]">
    <meta property="og:url" content="@Configuration["Config:UrlLogo"]">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="@Configuration["Config:UrlLogo"]">
    <meta name="twitter:title" content="Sistema de Inventario y Punto de Venta">
    <meta name="twitter:description" content="Gestiona tu inventario y ventas de manera eficiente con nuestra solución todo en uno.">
    <meta name="twitter:image" content="@Configuration["Config:UrlLogo"]">

</head>
<body>
 
    @Html.Partial("_Menu")
    
    <main class="main-content">
                   
            @RenderBody()
                   
    </main>

    <footer class="row bg-light py-2 mt-auto">
         <div class="col-12 text-center">  © @DateTime.Now.Year SmartStock - @Configuration["Config:AppName"] </div>
   </footer>
  

          


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.17.2/dist/sweetalert2.all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="  crossorigin="anonymous"></script>
  
    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.js"></script>
     <script src="https://cdn.datatables.net/responsive/3.0.8/js/dataTables.responsive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
