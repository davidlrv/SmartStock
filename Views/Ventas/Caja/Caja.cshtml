@{
    ViewData["Title"] = "Caja";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}
@model Caja

<section class="container-fluid" style="position:relative">
    <h1>Caja</h1>

    <h4>Se gestionan las Cajas del sistema</h4>
    <hr class="m-3">

    <div class="row pb-3">
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header text-center p-3 header-back">
                            <h3>Caja</h3>
                        </div>
                        <div class="card-body p-3">

                            @if (TempData["Message"] != null)
                            {
                                <div class="alert alert-@TempData["MessageType"]" id="mensaje">
                                    @TempData["Message"]

                                    <script>
                                                document.addEventListener("DOMContentLoaded", function () {
                                                    Swal.fire({
                                                        icon: "success",
                                                        text: @Html.Raw(Json.Serialize(TempData["Message"])),
                                                        confirmButtonColor: "#198754"
                                                    });
                                                });
                                    </script>
                                </div>
                            }

                            <form asp-controller="Caja" asp-action="GuardarCaja" method="post" id="myForm">

                                <div class="row g-3">
                                    @{
                                        var esSoloLectura = (User.IsInRole("Recepcion") || User.IsInRole("Administrador"));
                                    }

                                    <!-- Nombre Caja -->
                                    <div class="col-md-6">
                                        <label asp-for="NombreCaja" class="control-label"></label>
                                        <input asp-for="NombreCaja" class="form-control" required />
                                        <span asp-validation-for="NombreCaja" class="text-danger"></span>
                                    </div>

                                    <!-- Código Caja -->
                                    <div class="col-md-6">
                                        <label asp-for="Cod_Caja" class="control-label"></label>
                                        <input asp-for="Cod_Caja" class="form-control" required />
                                        <span asp-validation-for="Cod_Caja" class="text-danger"></span>
                                    </div>

                                    <!-- Estado -->
                                    <div class="col-md-12">
                                        <div class="form-check form-switch">
                                            <input asp-for="Estado" class="form-check-input" type="checkbox" id="activo">
                                            <label class="form-check-label" for="Estado">Estado</label>
                                            <span asp-validation-for="Estado" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <!-- Usuario oculto -->
                                    <input asp-for="Usuario" type="hidden" value="@User.Identity.Name" />
                                    <input asp-for="ID_Caja" type="hidden" />

                                </div>

                                <div class="mt-4 d-flex gap-2">

                                    <button id="btnAcceder1" type="button" class="btn btn-success" onclick="Guardar()">Guardar</button>
                                    <button type="submit" id="btnAcceder2" style="display:none;">Guardar</button>

                                    @if (User.IsInRole("Super Administrador") || User.IsInRole("Administrador"))
                                    {
                                        <a class="btn btn-outline-success" href="/Caja/ListaCaja">
                                            Regresar al Listado
                                        </a>
                                    }

                                </div>

                                @if (esSoloLectura)
                                {
                                    <script>
                                                document.getElementById('activo').addEventListener('click', function (e) {
                                                    e.preventDefault();
                                                });
                                    </script>
                                }

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("span.text-danger").forEach(function (span) {
            span.style.display = "none";
        });
    });

    function validateForm() {
        const requiredFields = document.querySelectorAll('#myForm input[required]');
        let firstMissingField = null;

        for (let field of requiredFields) {
            if (!field.value || !field.checkValidity()) {
                if (!firstMissingField) {
                    firstMissingField = field;
                }
            }
        }

        if (firstMissingField) {
            Swal.fire({
                icon: 'warning',
                title: 'Advertencia',
                text: 'Algunos campos faltan o están incorrectos: ' + firstMissingField.name,
                confirmButtonText: "Ok"
            }).then(() => {
                firstMissingField.scrollIntoView({ behavior: 'smooth', block: 'center' });

                setTimeout(() => {
                    firstMissingField.focus();
                    $(firstMissingField).next('span.text-danger').show();
                    $('#mensaje').hide();
                }, 500);
            });
            return false;
        }

        return true;
    }

    function Guardar() {
        event.preventDefault();
        if (validateForm()) {
            document.getElementById('btnAcceder2').click();
        }
    }
</script>