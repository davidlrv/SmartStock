@model List<SmartStock.Models.Impuestos>

@{
    ViewData["Title"] = "Lista de Impuestos";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Impuestos</h3>

@* Solamente Super Administrador puede agregar nuevos impuestos *@
@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-3 d-flex">
        <a class="btn btn-success"
           asp-area=""
           asp-controller="Configuraciones"
           asp-action="Impuestos">
            Agregar Impuesto
        </a>
    </p>
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>

<script>
    $(document).ready(function () {

        let table = new DataTable('#myTable', {
            responsive: true,
            language: {
                url: '/js/es-ES.json',
                emptyTable: "No hay impuestos disponibles."
            }
        });

    });
</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">
    <thead>
        <tr>
            <th>ID Impuesto</th>
            <th>Nombre Impuesto</th>
            <th>Porcentaje</th>
            <th>Activo</th>
            <th>Opciones</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var impuesto in Model)
            {
                <tr>

                    <td>@impuesto.ID_Impuesto</td>

                    <td>@impuesto.Nombre_Impuesto</td>

                   <td>@impuesto.Porcentaje.ToString("0.00")%</td>

                    <td>
                        @(impuesto.Estado ? "Sí" : "No")
                    </td>

                    <td>
                        <div class="row">

                            <div class="col-6 text-center">
                                <a class="btn btn-detalles"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Editar Impuesto"
                                   asp-controller="Configuraciones"
                                   asp-action="Impuestos"
                                   asp-route-ID_Impuesto="@impuesto.ID_Impuesto">

                                    <i class="bi bi-pencil-square"></i>

                                </a>
                            </div>

                        </div>
                    </td>

                </tr>
            }
        }

    </tbody>

</table>