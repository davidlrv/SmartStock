@{
    ViewData["Title"] = "Configuraciones  - Opciones";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<div class="container py-4">

    <h4 class="mb-4">⚙️ Configuraciones - Opciones  </h4>

    <div class="row g-4">

        <!-- Empresa -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🏢 Tipos de proveedores</h5>
                    <p class="card-text"> Agregar, Modificar, Eliminar tipo de proveedor</p>
                    <a asp-controller="Compra" asp-action="ListaTipos" class="btn btn-outline-primary btn-sm">Gestionar</a>
                </div>
            </div>
        </div>

        <!-- Usuarios -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">👤 Usuarios</h5>
                    <p class="card-text">Administra usuarios, roles y permisos del sistema.</p>
                    <a href="#" class="btn btn-outline-primary btn-sm">Gestionar</a>
                </div>
            </div>
        </div>

        <!-- Impuestos -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">💲 Impuestos</h5>
                    <p class="card-text">Define IVA, descuentos y reglas de facturación.</p>
                    <a asp-controller="Configuraciones" asp-action="ListaImpuestos" class="btn btn-outline-primary btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Inventario -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">📦 Inventario</h5>
                    <p class="card-text">Controla stock mínimo, alertas y movimientos.</p>
                    <a href="#" class="btn btn-outline-success btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Facturación -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🧾 Facturación</h5>
                    <p class="card-text">Series, numeración y formato de comprobantes.</p>
                    <a href="#" class="btn btn-outline-warning btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Seguridad -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🔐 Seguridad</h5>
                    <p class="card-text">Contraseñas, accesos y políticas de seguridad.</p>
                    <a href="#" class="btn btn-outline-danger btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Notificaciones -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🔔 Notificaciones</h5>
                    <p class="card-text">Alertas de stock, compras y eventos del sistema.</p>
                    <a href="#" class="btn btn-outline-info btn-sm">Configurar</a>
                </div>
            </div>
        </div>

        <!-- Apariencia -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🎨 Apariencia</h5>
                    <p class="card-text">Tema, colores y personalización visual.</p>
                    <a href="#" class="btn btn-outline-dark btn-sm">Configurar</a>
                </div>
            </div>
        </div>

    </div>
</div>
