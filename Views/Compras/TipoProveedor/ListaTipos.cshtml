@model List<SmartStock.Models.Tipo>

@{
    ViewData["Title"] = "Lista de Tipos";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Tipos</h3>

@* Solo Super Administrador puede agregar *@
@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-0 d-flex">
        <a class="btn btn-success" asp-area="" asp-controller="Compra" asp-action="Tipo">
            Agregar Tipo
        </a>
    </p>
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>

<script>
    $(document).ready(function () {
        let table = new DataTable('#myTable', {
            responsive: true,
            language: {
                url: '/js/es-ES.json'
            }
        });
    });
</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">
    <thead>
        <tr>
            <th>ID Tipo</th>
            <th>Nombre Tipo</th>
            <th>Activo</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tipo in Model)
        {
            <tr>
                <td>@tipo.ID_Tipo</td>
                <td>@tipo.Nombre_Tipo</td>
                <td>@(tipo.Estado == true ? "Sí" : "No")</td>
                <td>
                    <div class="row">
                        <div class="col-6 text-center">
                            <a class="btn btn-detalles"
                               data-bs-toggle='tooltip'
                               data-bs-placement='top'
                               title='Editar Tipo'
                               asp-controller="Compra"
                               asp-action="Tipo"
                               asp-route-ID_Tipo="@tipo.ID_Tipo">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>