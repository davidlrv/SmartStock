@model List<SmartStock.Models.Proveedor>

@{
    ViewData["Title"] = "Lista de Proveedores";
    Layout = "~/Views/Shared/_LayoutB.cshtml";
}

<h3 class="mb-4">Gestión de Proveedores</h3>

@*Solamente Super Administrador puede agregar nuevos proveedores*@
@if (User.IsInRole("Super Administrador"))
{
    <p class="mb-0 d-flex">
        <a class="btn btn-success" asp-area="" asp-controller="Compra" asp-action="Proveedor">Agregar Proveedor</a>
    </p>
}

<script>
    $(document).ready(function () {
        let table = new DataTable('#myTable', {
            responsive: true,
            language: {
                url: '/js/es-ES.json',
                emptyTable: "No hay proveedores disponibles."
            }
        });
    });
</script>

<table class="table table-striped table-responsive table-hover table-sm" id="myTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Contacto</th>
            <th>Teléfono Contacto</th>
            <th>Activo</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Proveedor in Model)
        {
            <tr>
                <td>@Proveedor.ID_Proveedores</td>
                <td>@Proveedor.Nombre</td>
                <td>@Proveedor.Email</td>
                <td>@Proveedor.Telefono</td>
                <td>@Proveedor.Nombre_Contacto</td>
                <td>@Proveedor.Numero_Contacto</td>
                <td>@(Proveedor.Estado ? "Sí" : "No")</td>
                <td>
                    <div class="row">
                        <div class="col-6 text-center">
                            <a class="btn btn-detalles"
                                   data-bs-toggle='tooltip'
                                   data-bs-placement='top'
                                   title='Proveedor'
                                   asp-controller="Compra"
                                   asp-action="Proveedor"
                                   asp-route-ID_Proveedores="@Proveedor.ID_Proveedores">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>